{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "ReverseProxy": {
    "Routes": {
      "webfinger": {
        "ClusterId": "megafono",
        "Order": 0,
        "Match": { "Path": "/.well-known/webfinger" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "nodeinfo-index": {
        "ClusterId": "megafono",
        "Order": 1,
        "Match": { "Path": "/.well-known/nodeinfo" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "nodeinfo": {
        "ClusterId": "megafono",
        "Order": 2,
        "Match": { "Path": "/nodeinfo/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "actors": {
        "ClusterId": "megafono",
        "Order": 3,
        "Match": { "Path": "/ap/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "inbox": {
        "ClusterId": "megafono",
        "Order": 4,
        "Match": { "Path": "/inbox" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "app": {
        "ClusterId": "app",
        "Order": 1000,
        "Match": { "Path": "{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "megafono": { "Destinations": { "primary": { "Address": "http://megafono:8080" } } },
      "app": { "Destinations": { "primary": { "Address": "http://app:8080" } } }
    }
  }
}
