# Copy to deploy/.env and fill in. Nothing here is a default you can keep: every secret must be generated.
# Passwords are placed in a connection string and in URLs: use letters and digits only (openssl rand -hex 24).

# Public host name of the deployment, no scheme or path. The actor ids and the WebFinger domain come from it
# and cannot change later without losing every follower.
DOMAIN=app.example.com

# Base64 of 32 random bytes. Encrypts every actor's private key. BACK IT UP apart from the database:
# losing it makes every actor unusable (docs/operating.md).
#   openssl rand -base64 32
MEGAFONO_MASTER_KEY=

# Bearer token between the app and Megáfono, in both directions (the app's calls to the internal API and
# Megáfono's calls to the app's lookup).
#   openssl rand -hex 32
MEGAFONO_TOKEN=

# Secret that signs the webhooks Megáfono sends to the app (Megafono-Signature, HMAC-SHA256).
#   openssl rand -hex 32
MEGAFONO_WEBHOOK_SECRET=

# Password of the Postgres user "megafono".
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Password for the sample app's manage pages (HTTP Basic, any user name).
#   openssl rand -hex 16
SAMPLE_ADMIN_PASSWORD=

# TLS certificate chain and private key (PEM) for DOMAIN, mounted read-only into the gateway.
# Let's Encrypt: /etc/letsencrypt/live/<DOMAIN>/fullchain.pem and privkey.pem.
# A self-signed pair for a local trial:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj "/CN=localhost" -keyout tls.key -out tls.crt
TLS_CERT_PATH=./tls/tls.crt
TLS_KEY_PATH=./tls/tls.key
